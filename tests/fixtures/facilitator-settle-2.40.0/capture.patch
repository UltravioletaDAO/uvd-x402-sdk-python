+//! Scratch-only capture for the Python SDK fixtures. Never committed to x402-rs.
+use super::*;
+
+#[tokio::test]
+async fn capture_receipt_rail_unavailable_for_the_python_sdk() {
+    let response = unavailable("receipt_store_unavailable");
+    let status = response.status().as_u16();
+    let retry_after = response
+        .headers()
+        .get(RETRY_AFTER)
+        .map(|v| v.to_str().expect("ascii").to_string());
+    let bytes = axum::body::to_bytes(response.into_body(), usize::MAX)
+        .await
+        .expect("body");
+    let body = String::from_utf8(bytes.to_vec()).expect("utf8");
+    let dir = std::env::var("SDK_CAPTURE_DIR").expect("SDK_CAPTURE_DIR");
+    let record = serde_json::json!({
+        "source": "x402-rs 8ee44114 (2.40.0), src/receipts/mod.rs",
+        "case": "receipt_store_unavailable",
+        "status": status,
+        "retryAfter": retry_after,
+        "body": body,
+    });
+    std::fs::write(
+        format!("{dir}/receipt_store_unavailable.json"),
+        serde_json::to_string_pretty(&record).expect("json"),
+    )
+    .expect("write");
+}
