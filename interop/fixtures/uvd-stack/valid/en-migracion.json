      ],
      "erc8128": {
        "authorities": [
          "api.tablero.example"
        ],
        "chain_ids": [
          8453
        ],
        "preset": "evento-s2s",
        "nonce": {
          "source": "unseen"
        }
      }
    }
  },
  "identity": {
